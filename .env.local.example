# NULL RITE Web - Environment Variables
# Copy to .env.local and fill in public values only.

# Runtime network. Keep testnet for rehearsal; switch to mainnet only for the
# production release after the mainnet Vessel contract has been deployed.
NEXT_PUBLIC_NULLRITE_NETWORK=testnet

# Vessel contract for the selected runtime network.
NEXT_PUBLIC_NULLRITE_ADDRESS=0xd3E85fe5D282e1bc49F4A6B189272Ec874D29500

# Reown Project ID. Required for WalletConnect mobile handoff / QR fallback.
NEXT_PUBLIC_REOWN_PROJECT_ID=

# IPFS Gateway for metadata & images.
NEXT_PUBLIC_IPFS_GATEWAY=https://gateway.lighthouse.storage/ipfs/
