# NULL RITE — committed production env (public vars only)
# NEXT_PUBLIC_* vars are inlined at build time and shipped to the browser.
#
# Wallet layer migrated to Reown AppKit. Configure a real Reown Cloud project ID
# in Vercel as NEXT_PUBLIC_REOWN_PROJECT_ID. The legacy NEXT_PUBLIC_WC_ID remains
# supported as a fallback during migration.
NEXT_PUBLIC_WC_ID=your_walletconnect_project_id_here
