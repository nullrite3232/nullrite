# NULL RITE — committed public defaults.
# NEXT_PUBLIC_* values are shipped to the browser; never place private secrets here.
# Vercel environment variables override these defaults when configured.

# Testnet is the safe rehearsal default. Mainnet must be selected explicitly.
NEXT_PUBLIC_NULLRITE_NETWORK=testnet
NEXT_PUBLIC_NULLRITE_ADDRESS=0x4c2ab9b12a67bf7173ba2630fbad7824a299924e

# Set the real value in Vercel before WalletConnect/mobile public testing.
NEXT_PUBLIC_REOWN_PROJECT_ID=
